 (async function() {
  // Prevent duplicate initialization
  if (window.accessoriesInitialized) return;
  window.accessoriesInitialized = true;

  // Accessory subcategories for filtering
  const accessoryTypes = {
    'Phone Accessories': [
      'Phone Cases & Covers',
