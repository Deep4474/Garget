    ],
    'Audio Accessories': [
      'earbuds', 'airpods', 'headphones', 'headset', 'earphones',
      'bluetooth speaker', 'wireless speaker', 'microphone', 'mic'
    ],
    'Computer Accessories': [
      'keyboard', 'mouse', 'mousepad', 'usb drive', 'flash drive',
      'hard drive', 'ssd', 'laptop bag', 'laptop sleeve', 'webcam',
      'cooling pad', 'laptop stand', 'computer accessories'
    ],
    'Networking': [
      'wifi router', 'network switch', 'ethernet cable', 'lan cable',
      'wifi adapter', 'network card', 'modem', 'wifi extender',
      'network accessories', 'networking'
    ],
    'Gaming Accessories': [
      'game controller', 'gaming headset', 'gaming mouse', 'gaming keyboard',
      'gaming accessories', 'game accessories', 'gaming gear'
    ]
  };

  // Ensure there is a supabase client (supabase-config.js should provide this)
  if (!window.supabaseClient && typeof supabase !== 'undefined' && typeof supabase.createClient === 'function') {
    try {
      // If you have env vars, prefer those. Fallback values are intentionally not set here.
      window.supabaseClient = supabase.createClient(window.SUPABASE_URL || '', window.SUPABASE_ANON_KEY || '');
    } catch (e) {
      console.warn('[accessories] Failed to create Supabase client:', e);
    }
  }

  // Function to check if a product is an accessory and determine its type
  function isAccessory(product) {
    // First, explicitly exclude main product categories
    const excludeKeywords = [
      'laptop computer', 'notebook computer', 'desktop computer', 
      'smartphone device', 'mobile device', 'tablet device', 'television set',
      'smart tv device'
    ];
    
    const searchText = [
      product.name || '',
      product.category || '',
      product.description || '',
      product.subcategory || '',
      product.type || '',
      (product.tags && Array.isArray(product.tags) ? product.tags.join(' ') : product.tags || '')
    ].join(' ').toLowerCase();

    // Check category field first - if it explicitly says "accessories", it's an accessory
    if ((product.category || '').toLowerCase().includes('accessories')) {
      return true;
  // Fetch accessories from Supabase
  async function fetchAccessories() {
    const grid = document.getElementById('productsGrid');
    if (!grid) return;
    
    grid.innerHTML = '<div class="loading-spinner">Loading accessories...</div>';

    // Make sure we have a Supabase client
    if (!window.supabaseClient && window.SUPABASE_URL && window.SUPABASE_ANON_KEY) {
      try {
        window.supabaseClient = supabase.createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY);
      } catch (e) {
        console.error('Failed to initialize Supabase client:', e);
        grid.innerHTML = '<div class="error-message">Failed to load products</div>';
        return [];
      }
    }

    // Collect all keywords for the query
    const allKeywords = Object.values(accessoryKeywords).flat();
    const results = [];

    try {
      // Build the query conditions
      const searchFields = ['name', 'category', 'description', 'subcategory', 'type', 'tags'];
      const orConditions = [];
      
      // Add direct category matches
      orConditions.push(`category.ilike.%accessories%`);
      
      // Add keyword matches across all fields
      for (const field of searchFields) {
        for (const keyword of allKeywords) {
          const esc = keyword.replace(/\s+/g, ' ').trim();
          if (esc) {
            orConditions.push(`${field}.ilike.%${encodeURIComponent(esc)}%`);
          }
        }
      } || product.amount || 0);
    if (price > 0 && price < 100000) {
      // Check if it has accessory-like words
      const accessoryIndicators = ['kit', 'adapter', 'cable', 'cover', 'protection', 'add-on', 'attachment'];
      if (accessoryIndicators.some(word => searchText.includes(word))) {
        return true;
      }
    }

    return false;
  }

  // Fetch accessories from multiple tables
  async function fetchAccessories() {
    // Prefer REST queries against the new Supabase project first
    const TABLES = ['products'];
    const REST_BASE = 'https://ahzfkfxqtdtkrwlxvimp.supabase.co'.replace(/\/$/, '') + '/rest/v1';
    const REST_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFoemZrZnhxdGR0a3J3bHh2aW1wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjE4MTcyMDksImV4cCI6MjA3NzM5MzIwOX0.us--sBWAKTPJrd4gPKMPLBgtkJVhAcrUEQoD9YTnJww';
    const results = [];

    // Build OR clause for keywords across name, category, description
    const kw = accessoryKeywords.map(k => k.replace(/\s+/g,' '));
    const orParts = [];
    for (const k of kw) {
      const esc = encodeURIComponent(k);
      orParts.push(`name.ilike.*${esc}*`);
      orParts.push(`category.ilike.*${esc}*`);
      orParts.push(`description.ilike.*${esc}*`);
    }
    const orParam = orParts.join(',');

      // Query Supabase
      if (window.supabaseClient) {
        const { data, error } = await window.supabaseClient
          .from('products')
          .select('*')
          .or(orConditions.join(','))
          .order('created_at', { ascending: false })
          .limit(1000);

        if (error) {
          console.error('Error fetching accessories:', error);
          grid.innerHTML = '<div class="error-message">Failed to load accessories</div>';
          return [];
        }

        if (data && Array.isArray(data)) {
          // Filter for actual accessories
          const accessories = data.filter(isAccessory);
          
          // Group by category
          const categorized = {};
          for (const product of accessories) {
            const category = product._accessory_category || 'Other Accessories';
            if (!categorized[category]) {
              categorized[category] = [];
            }
            categorized[category].push(product);
          }

          // Render the results by category
          if (Object.keys(categorized).length === 0) {
            grid.innerHTML = '<div class="no-results">No accessories found</div>';
          } else {
            grid.innerHTML = Object.entries(categorized).map(([category, products]) => `
              <div class="category-section">
                <h2 class="category-title">${category}</h2>
                <div class="products-grid">
                  ${products.map(product => `
                    <div class="product-card" data-id="${product.id}">
                      <img src="${product.image_url || 'assets/images/default-accessory.png'}" 
                           alt="${product.name}" 
                           class="product-image"
                           onerror="this.src='assets/images/default-accessory.png'">
                      <div class="product-info">
                        <h3 class="product-name">${product.name}</h3>
                        <p class="product-price">₦${new Intl.NumberFormat('en-NG').format(product.price || 0)}</p>
                        <button class="add-to-cart-btn">Add to Cart</button>
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `).join('');
          }

          // Add event listeners
          grid.querySelectorAll('.product-card').forEach(card => {
            card.addEventListener('click', (e) => {
              if (!e.target.matches('.add-to-cart-btn')) {
                const productId = card.dataset.id;
                window.location.href = `product.html?id=${productId}`;
              }
            });
          });
          }
        }

        // Only use fallback if REST call didn't succeed
        if (results.length === 0 && window.supabaseClient && typeof window.supabaseClient.from === 'function') {
          const { data, error } = await window.supabaseClient.from(table).select('*').order('created_at', { ascending: false });
          if (!error && Array.isArray(data) && data.length) {
            data.filter(isAccessory).forEach(p => {
              // Check if this product is already in results
              if (!results.some(existing => existing.id === p.id)) {
                results.push(Object.assign({}, p, { _source_table: table }));
              }
            });
          }
        }
      } catch (e) {
        console.warn(`[accessories] Exception fetching from ${table}:`, e);
      }
    }

    return results;
  }

  // Render accessory grid
  async function renderAccessoryGrid(filterType = null) {
    const grid = document.getElementById('accessoriesGrid');
    if (!grid) return;

    grid.innerHTML = '<div class="ap-loading"><span class="ap-spinner"></span> Loading accessories...</div>';

    try {
      const accessories = await fetchAccessories();
      console.log('[accessories] Total accessories fetched:', accessories.length);
      accessories.forEach(p => console.log('[accessories] Found:', p.name, 'Category:', p.category));

      if (!accessories.length) {
        grid.innerHTML = '<div class="ap-empty">No accessories found.</div>';
        return;
      }

      const filtered = filterType && filterType !== 'All Accessories'
        ? accessories.filter(product => {
            const txt = [product.name, product.category, product.description].join(' ').toLowerCase();
            return txt.includes(filterType.toLowerCase());
          })
        : accessories;

      grid.innerHTML = filtered.map(product => `
        <div class="product-card">
          <img src="${product.image_url || 'assets/images/computing.png'}" alt="${product.name}" class="product-image" onerror="this.src='assets/images/computing.png'">
          <div class="product-info">
            <h2 class="product-title">${product.name}</h2>
            <p class="product-price">₦${Number(product.price || 0).toLocaleString()}</p>
            <button class="add-to-cart-btn" data-id="${product.id}" data-table="${product._source_table}">Add to Cart</button>
          </div>
        </div>
      `).join('');

      // hook add to cart
      grid.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const id = this.dataset.id;
          const table = this.dataset.table;
          if (typeof window.addToCart === 'function') window.addToCart(id, table);
        });
      });

    } catch (e) {
      console.error('[accessories] Error rendering grid:', e);
      grid.innerHTML = '<div class="ap-error">Failed to load accessories.</div>';
    }
  }

  // Create filter buttons
  function createFilterButtons() {
    const container = document.querySelector('.accessory-filters');
    if (!container) return;

    container.innerHTML = accessoryTypes.map(t => `<button class="filter-btn" data-type="${t}">${t}</button>`).join('');
    container.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        container.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderAccessoryGrid(btn.dataset.type);
      });
    });
  }

  // Initialize
  try {
    createFilterButtons();
    await renderAccessoryGrid();
  } catch (e) {
    console.error('[accessories] Initialization error:', e);
  }

})();