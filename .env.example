# .env.example - copy to .env and fill the real values locally (do NOT commit real secrets)

# Supabase (optional, used for orders and OAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here

# Server port
PORT=3000

# SMTP (Gmail example)
# If using Gmail, use smtp.gmail.com and an App Password (do NOT use your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ayomideoluniyi49@gmail.com
SMTP_PASS=tnuj mxpq lgph jzqr
EMAIL_FROM="Your Store <ayomideoluniyi49@gmail.com>"

# Development helpers
# When running without SMTP configured the server will return verification codes in the JSON response
DEV_MOCK=false

# Notes:
# - Never commit `.env` with real secrets to source control.
# - Create an App Password in your Google Account (2FA must be enabled) and paste it into SMTP_PASS in your local `.env`.
# - On Windows/PowerShell you can use the example commands below to inject the password without echoing it live.
